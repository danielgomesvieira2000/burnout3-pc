# Never commit copyrighted material: disc images, extracted game files, or
# anything derived from them that contains original code or assets.
*.iso
*.ISO
extracted/
asm/
build/
# Release packages (games/<name>/port/tools/package.py writes them under build/).
*.zip
# The user's console BIOS dumps (PCSX2 references): never committed.
bios/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# A game's own code in C++ - lifted (a mechanical translation), derived and
# reconstructed - is the game's, and regenerated from the player's disc by the
# tools (lift.py --emit, derive.py --emit): never committed.
games/*/src/
games/*/include/*/

# Pictures made from a game's models (the EXTRA SERIES' car select pictures,
# games/burnout3/port/extra_pictures/): the game's, never committed.
games/*/port/extra_pictures/
!games/*/include/ps2/

# Texture packs (PCSX2 replacements: third-party art made from the game's textures): never committed.
replacements/
texture pack/
texture_pack/

# Third-party PCSX2 mods (the player's own, read at build time; never committed)
b3 mod pnachs/
